    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.0.0",
    "jsdom": "^30.1.2",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
