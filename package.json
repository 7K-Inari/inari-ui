    "@tailwindcss/vite": "^4.3.3",
    "7k-design-system": "^1.3.0-edge.ee94c56",
    "keycloak-js": "^26.0.0",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
