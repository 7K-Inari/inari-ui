# Keycloak OIDC configuration (dev Keycloak is provisioned by inari-helm-charts M0)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=inari
VITE_KEYCLOAK_CLIENT_ID=inari-ui

# Control plane REST API (served by inari-server)
VITE_API_BASE_URL=/api/v1
# Serve mocked API responses in dev until inari-server M1 endpoints are available
VITE_MOCK_API=true

