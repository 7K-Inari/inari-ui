{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": {
          "type": "string",
          "description": "Registry prefix prepended to every image/artifact repository rendered by this chart (mirrored/air-gapped installs)."
        },
        "imagePullSecrets": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Names of pre-created pull secrets rendered into every pod spec (covers the oras init container)."
        }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "bundle": {
      "type": "object",
      "description": "OCI artifact carrying the built console (oras layout). global.imageRegistry is prepended to the repository; digest wins over tag.",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "digest": { "type": "string" }
      },
      "required": ["repository", "tag"]
    },
    "keycloakUrl": { "type": "string" },
    "keycloakRealm": { "type": "string", "minLength": 1 },
    "keycloakClientId": { "type": "string", "minLength": 1 },
    "apiBaseUrl": { "type": "string" },
    "oras": {
      "type": "object",
      "description": "oras CLI image used by the init container to pull the bundle.",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "digest": { "type": "string" }
          },
          "required": ["repository", "tag"]
        }
      }
    },
    "nginx": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "digest": { "type": "string" }
          },
          "required": ["repository", "tag"]
        },
        "corsOrigins": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "resources": { "type": "object" },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "namespace": { "type": "string" },
        "sectionName": { "type": "string" }
      }
    },
    "route": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "hostnames": { "type": "array", "items": { "type": "string" } },
        "pathPrefix": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" }
  }
}
